<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Ferrari | Performance</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
    crossorigin="anonymous">

  <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>

<body>

  <!-- NAVBAR -->
  <header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">

        <a class="navbar-brand fw-bold fs-3" href="#">
          FERRARI
        </a>

        <button class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#menu"
          aria-controls="menu"
          aria-expanded="false"
          aria-label="Abrir menu">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">

          <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

            <li class="nav-item">
              <a class="nav-link active" href="#">Início</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="#modelos">Modelos</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="#historia">História</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="#contato">Contato</a>
            </li>

          </ul>

          <a href="#modelos" class="btn btn-danger ms-lg-4">
            Conheça os carros
          </a>

        </div>
      </div>
    </nav>
  </header>


  <!-- CAROUSEL -->
  <main>

    <section class="bg-dark">

      <div id="ferrariCarousel"
        class="carousel slide"
        data-bs-ride="carousel">

        <!-- INDICADORES -->
        <div class="carousel-indicators">

          <button type="button"
            data-bs-target="#ferrariCarousel"
            data-bs-slide-to="0"
            class="active"
            aria-current="true"
            aria-label="Imagem 1">
          </button>

          <button type="button"
            data-bs-target="#ferrariCarousel"
            data-bs-slide-to="1"
            aria-label="Imagem 2">
          </button>

          <button type="button"
            data-bs-target="#ferrariCarousel"
            data-bs-slide-to="2"
            aria-label="Imagem 3">
          </button>

        </div>


        <!-- IMAGENS -->
        <div class="carousel-inner">

          <div class="carousel-item active">
            <img src="img/carro.jpg"
              class="d-block w-100"
              alt="Ferrari esportiva"
              style="height: 600px; object-fit: cover;">

            <div class="carousel-caption text-start">
              <h1 class="display-3 fw-bold">
                Performance sem limites
              </h1>

              <p class="fs-5">
                Design, velocidade e tecnologia em perfeita harmonia.
              </p>

              <a href="#modelos"
                class="btn btn-danger btn-lg">
                Descubra
              </a>
            </div>
          </div>


          <div class="carousel-item">
            <img src="img/frontal.jpg"
              class="d-block w-100"
              alt="Frente de uma Ferrari"
              style="height: 600px; object-fit: cover;">

            <div class="carousel-caption text-start">
              <h2 class="display-4 fw-bold">
                Design italiano
              </h2>

              <p class="fs-5">
                Cada detalhe pensado para impressionar.
              </p>
            </div>
          </div>


          <div class="carousel-item">
            <img src="img/ferrari.jpg"
              class="d-block w-100"
              alt="Ferrari vermelha"
              style="height: 600px; object-fit: cover;">

            <div class="carousel-caption text-start">
              <h2 class="display-4 fw-bold">
                A paixão pela velocidade
              </h2>

              <p class="fs-5">
                Uma tradição construída nas pistas.
              </p>
            </div>
          </div>

        </div>


        <!-- CONTROLES -->
        <button class="carousel-control-prev"
          type="button"
          data-bs-target="#ferrariCarousel"
          data-bs-slide="prev">

          <span class="carousel-control-prev-icon"></span>
          <span class="visually-hidden">Anterior</span>

        </button>

        <button class="carousel-control-next"
          type="button"
          data-bs-target="#ferrariCarousel"
          data-bs-slide="next">

          <span class="carousel-control-next-icon"></span>
          <span class="visually-hidden">Próximo</span>

        </button>

      </div>

    </section>


    <!-- INTRODUÇÃO -->
    <section class="py-5 bg-light" id="modelos">

      <div class="container">

        <div class="text-center mb-5">

          <span class="text-danger fw-bold">
            FERRARI
          </span>

          <h2 class="display-5 fw-bold">
            Excelência em cada detalhe
          </h2>

          <p class="lead text-secondary mx-auto"
            style="max-width: 700px;">
            Conheça o universo Ferrari, onde tecnologia,
            design e performance se encontram.
          </p>

        </div>


        <!-- GRID -->
        <div class="row g-4">

          <!-- CARD 1 -->
          <div class="col-12 col-md-4">

            <div class="card h-100 border-0 shadow-sm">

              <div class="card-body p-4">

                <div class="bg-dark text-white rounded-circle
                  d-flex align-items-center justify-content-center
                  mb-4"
                  style="width: 55px; height: 55px;">

                  <i class="bi bi-speedometer2 fs-4"></i>

                </div>

                <h3 class="h4 fw-bold">
                  Performance
                </h3>

                <p class="text-secondary">
                  Motores desenvolvidos para entregar
                  potência, precisão e uma experiência
                  de condução extraordinária.
                </p>

                <a href="#"
                  class="btn btn-outline-dark">
                  Saiba mais
                </a>

              </div>

            </div>

          </div>


          <!-- CARD 2 -->
          <div class="col-12 col-md-4">

            <div class="card h-100 border-0 shadow-sm">

              <div class="card-body p-4">

                <div class="bg-danger text-white rounded-circle
                  d-flex align-items-center justify-content-center
                  mb-4"
                  style="width: 55px; height: 55px;">

                  <i class="bi bi-car-front-fill fs-4"></i>

                </div>

                <h3 class="h4 fw-bold">
                  Design
                </h3>

                <p class="text-secondary">
                  Linhas marcantes e aerodinâmica combinadas
                  com o clássico design italiano.
                </p>

                <a href="#"
                  class="btn btn-danger">
                  Ver modelos
                </a>

              </div>

            </div>

          </div>


          <!-- CARD 3 -->
          <div class="col-12 col-md-4">

            <div class="card h-100 border-0 shadow-sm">

              <div class="card-body p-4">

                <div class="bg-dark text-white rounded-circle
                  d-flex align-items-center justify-content-center
                  mb-4"
                  style="width: 55px; height: 55px;">

                  <i class="bi bi-trophy-fill fs-4"></i>

                </div>

                <h3 class="h4 fw-bold">
                  Racing
                </h3>

                <p class="text-secondary">
                  Uma história construída nas pistas e
                  traduzida para os carros de rua.
                </p>

                <a href="#"
                  class="btn btn-outline-dark">
                  Nossa história
                </a>

              </div>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- SEÇÃO DE DESTAQUE -->
    <section class="bg-dark text-white py-5" id="historia">

      <div class="container">

        <div class="row align-items-center">

          <div class="col-lg-7">

            <span class="text-danger fw-bold">
              DESDE AS PISTAS
            </span>

            <h2 class="display-5 fw-bold mt-2">
              Uma história movida pela paixão
            </h2>

            <p class="lead text-secondary">
              A Ferrari combina tradição, inovação e
              desempenho para criar automóveis que
              representam muito mais do que velocidade.
            </p>

            <button class="btn btn-danger btn-lg">
              Conheça a história
            </button>

          </div>

          <div class="col-lg-5 mt-4 mt-lg-0">

            <div class="border-start border-danger border-4 ps-4">

              <h3 class="fw-bold">
                Tecnologia
              </h3>

              <p class="text-secondary mb-0">
                Engenharia e inovação aplicadas para
                alcançar o máximo desempenho.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>

  </main>


  <!-- FOOTER -->
  <footer class="bg-black text-white py-5" id="contato">

    <div class="container">

      <div class="row g-4">

        <div class="col-md-5">

          <h3 class="fw-bold">
            FERRARI
          </h3>

          <p class="text-secondary">
            Performance, design e tradição italiana.
          </p>

          <div class="d-flex gap-3">

            <a href="#"
              class="text-white fs-4">
              <i class="bi bi-instagram"></i>
            </a>

            <a href="#"
              class="text-white fs-4">
              <i class="bi bi-facebook"></i>
            </a>

            <a href="#"
              class="text-white fs-4">
              <i class="bi bi-youtube"></i>
            </a>

          </div>

        </div>


        <div class="col-6 col-md-3">

          <h5 class="fw-bold">
            Navegação
          </h5>

          <ul class="list-unstyled">

            <li class="mb-2">
              <a href="#"
                class="text-secondary text-decoration-none">
                Início
              </a>
            </li>

            <li class="mb-2">
              <a href="#modelos"
                class="text-secondary text-decoration-none">
                Modelos
              </a>
            </li>

            <li class="mb-2">
              <a href="#historia"
                class="text-secondary text-decoration-none">
                História
              </a>
            </li>

            <li>
              <a href="#contato"
                class="text-secondary text-decoration-none">
                Contato
              </a>
            </li>

          </ul>

        </div>


        <div class="col-6 col-md-4">

          <h5 class="fw-bold">
            Newsletter
          </h5>

          <p class="text-secondary">
            Receba novidades sobre carros e novidades.
          </p>

          <div class="input-group">

            <input type="email"
              class="form-control"
              placeholder="Seu e-mail"
              aria-label="Seu e-mail">

            <button class="btn btn-danger">
              Inscrever
            </button>

          </div>

        </div>

      </div>


      <hr class="border-secondary my-4">


      <div class="d-flex flex-column flex-md-row
        justify-content-between
        text-secondary">

        <p class="mb-0">
          © 2025 Ferrari. Todos os direitos reservados.
        </p>

        <p class="mb-0">
          Desenvolvido com Bootstrap
        </p>

      </div>

    </div>

  </footer>

<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
</body>

</html>
